# Required: long random secret (never commit a real value)
WAN_WORKER_API_KEY=

# Platform mode: mac_dev (local API/tests) | linux_cuda (NVIDIA inference)
# Leave empty to auto-detect: Darwin -> mac_dev, Linux -> linux_cuda
WAN_RUNTIME_MODE=mac_dev
# mac_mps | linux_cuda (upstream generate.py); defaults from runtime mode
WAN_INFERENCE_BACKEND=mac_mps

# --- macOS (mac_dev) typical paths (repo-relative) ---
# WAN_REPO_DIR=third_party/Wan2.2
# WAN_CKPT_DIR=Wan2.2-TI2V-5B
# WAN_JOBS_DIR=wan_jobs

# --- Linux GPU (linux_cuda) typical paths ---
# WAN_REPO_DIR=third_party/Wan2.2
# WAN_CKPT_DIR=/var/lib/wan/Wan2.2-TI2V-5B
# WAN_JOBS_DIR=/var/lib/wan/jobs

WAN_REPO_DIR=third_party/Wan2.2
WAN_CKPT_DIR=Wan2.2-TI2V-5B
WAN_GENERATE_SCRIPT=
WAN_PYTHON=python

# Service bind
WAN_WORKER_HOST=127.0.0.1
WAN_WORKER_PORT=8080

# Job storage (relative paths resolve from repository root)
WAN_JOBS_DIR=wan_jobs
WAN_MAX_QUEUE_SIZE=8
WAN_MAX_IMAGE_BYTES=10485760
WAN_MAX_PROMPT_CHARS=8000

# Inference output sizes (official TI2V-5B presets)
WAN_SIZE_LANDSCAPE=1280*704
WAN_SIZE_PORTRAIT=704*1280

# linux_cuda VRAM heuristic (GB); passing does not guarantee generation succeeds
WAN_MIN_VRAM_GB=14

# FFmpeg
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
