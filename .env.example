APP_NAME="Wan 2.2 GPU Service"
APP_VERSION=0.1.0
LOG_LEVEL=INFO

WAN_RUNTIME_MODE=linux_cuda
WAN_INFERENCE_BACKEND=linux_cuda

# Wan assets live under wan_service/
WAN_REPO_DIR=wan_service/third_party/Wan2.2
WAN_CKPT_DIR=wan_service/models/Wan2.2-TI2V-5B
WAN_GENERATE_SCRIPT=wan_service/third_party/Wan2.2/generate.py
WAN_PYTHON=venv/bin/python

WAN_WORKER_HOST=127.0.0.1
WAN_WORKER_PORT=8080
WAN_WORKER_API_KEY=admin_user
# Browser loader: http://127.0.0.1:8080/ui/job_loader.html (uses this API key)

WAN_JOBS_DIR=wan_jobs
WAN_MAX_QUEUE_SIZE=8
WAN_MAX_IMAGE_BYTES=10485760
WAN_MAX_PROMPT_CHARS=8000

FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe

WAN_SIZE_LANDSCAPE=1280*704
WAN_SIZE_PORTRAIT=704*1280
# Optional speed/quality tradeoff (omit or leave empty for model defaults: 50 steps, 121 frames).
WAN_INFERENCE_SAMPLE_STEPS=25
WAN_INFERENCE_FRAME_NUM=25
WAN_MIN_VRAM_GB=14.0
# Full-GPU mode when VRAM >= WAN_GPU_ONLY_MIN_VRAM_GB (else T5-on-CPU + offload).
WAN_INFERENCE_GPU_ONLY=true
# 23 GB cards: keep false so T5-on-CPU + offload is used (full-GPU often OOMs on TI2V).
WAN_INFERENCE_FORCE_GPU_ONLY=false
WAN_GPU_ONLY_MIN_VRAM_GB=24.0
WAN_CUDA_DEVICE=0

# Load TI2V once at startup; job 2+ skip checkpoint reload (recommended on GPU hosts).
# Keep false when swapping Wan/LTX on one GPU so LTX has VRAM headroom.
WAN_PERSISTENT_INFERENCE=false
WAN_WORKER_LOAD_TIMEOUT_SEC=900

# Multi-engine create-job: engine_type = wan | ltx | cogvideox | storyboard
# LTX assets live under ltx_service/ (see scripts/runpod_remote_setup_ltx.sh)
LTX_PYTHON=ltx_service/engines/ltx-env/bin/python
LTX_ENV_DIR=ltx_service/engines/ltx-env
LTX_REPO_DIR=ltx_service/third_party/LTX-Video
LTX_MODEL_PATH=ltx_service/models/ltx/ltxv-2b-0.9.6-distilled-04-25.safetensors
LTX_PIPELINE_CONFIG=configs/ltxv-2b-0.9.6-distilled.yaml

# CogVideoX-2B separate service (see scripts/runpod_remote_setup_cogvideox.sh)
# Isolated env + models under cogvideox_service/ — same pattern as ltx_service/
COGVIDEOX_PYTHON=cogvideox_service/engines/cogvideox-env/bin/python
COGVIDEOX_ENV_DIR=cogvideox_service/engines/cogvideox-env
COGVIDEOX_MODEL_PATH=cogvideox_service/models/cogvideox/CogVideoX-2b
COGVIDEOX_HF_ID=zai-org/CogVideoX-2b
COGVIDEOX_MEMORY_MODE=memory
COGVIDEOX_DTYPE=float16
COGVIDEOX_DEFAULT_WIDTH=720
COGVIDEOX_DEFAULT_HEIGHT=480
COGVIDEOX_DEFAULT_NUM_FRAMES=49
COGVIDEOX_DEFAULT_FPS=8
COGVIDEOX_DEFAULT_STEPS=50
COGVIDEOX_DEFAULT_GUIDANCE_SCALE=6.0
COGVIDEOX_DEFAULT_SEED=12345

# Free local LLM rewrite before LTX (ollama serve + ollama pull llama3.2:3b).
# On GPUs with under 30GB VRAM, in-process Florence/Llama enhancers stay off; Ollama runs first.
LTX_PROMPT_ENHANCE=true
LTX_OLLAMA_BASE_URL=http://127.0.0.1:11434
LTX_OLLAMA_MODEL=llama3.2:3b
LTX_OLLAMA_TIMEOUT_SEC=60
# Lower strength / higher noise => more I2V motion (distilled locks hard near 1.0).
LTX_CONDITIONING_STRENGTH=0.7
LTX_IMAGE_COND_NOISE_SCALE=0.5
LTX_DEFAULT_DURATION_SECONDS=5
LTX_DEFAULT_FPS=24
# Exaggerate deviation from first frame so distilled I2V motion is visible (1.0=off).
LTX_MOTION_AMPLIFY=2.4
# Durations above this are queued as sequential chunks with last-frame continuity.
LTX_CHUNK_SECONDS=10
# Drop held last-frame tails so chunks/final don't freeze on the last pose.
LTX_TRIM_TRAILING_FREEZE=true
LTX_TRIM_DIFF_THRESHOLD=1.5
LTX_CHUNK_MIN_TRIM_FRAMES=12
LTX_FINAL_MIN_TRIM_FRAMES=8
# Continuation chunks: stronger lock to previous last frame, no motion-amplify.
LTX_BRIDGE_CONDITIONING_STRENGTH=0.88
LTX_BRIDGE_IMAGE_COND_NOISE_SCALE=0.2
LTX_AMPLIFY_CONTINUATION_CHUNKS=false
STORYBOARD_DEFAULT_FPS=24

# Passed through to PyTorch subprocesses (reduces fragmentation OOMs).
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
# Keep off unless hf_transfer is installed; otherwise HF downloads can leave 0-byte files.
HF_HUB_ENABLE_HF_TRANSFER=0
